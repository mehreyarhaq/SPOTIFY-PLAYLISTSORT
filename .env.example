# Copy to .env and fill in. Never commit .env.

# --- Spotify (required from Milestone 1) ---
# Create an app at https://developer.spotify.com/dashboard
#   - Redirect URI must be exactly: http://127.0.0.1:8888/callback
#   - APIs used: Web API
# The app owner account must be Spotify Premium (Dev Mode rule since Feb 2026).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Beatport (Milestone 2) ---
# Either your Beatport login (the tool logs in once and keeps a refresh token) ...
BEATPORT_USERNAME=
BEATPORT_PASSWORD=
# ... or a bearer token pasted from your browser's DevTools (Network tab, Authorization header).
BEATPORT_BEARER_TOKEN=

# --- SonoVault (Milestone 2, free key at https://sonovault.now) ---
SONOVAULT_API_KEY=

# --- Discogs (Milestone 2, personal token at https://www.discogs.com/settings/developers) ---
DISCOGS_TOKEN=

# --- Local audio (Milestone 4) ---
# Colon-separated folders containing your downloaded tracks.
LOCAL_MUSIC_DIRS=
# rekordbox XML export (File -> Export Collection in xml format).
REKORDBOX_XML=

# --- Storage ---
PLAYLISTSORT_DATA_DIR=./data
